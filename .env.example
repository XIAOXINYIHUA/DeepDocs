# ─── DeepSeek ───
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# ─── 数据库 ───
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=deepdocs
POSTGRES_PASSWORD=deepdocs_secret
POSTGRES_DB=deepdocs

# ─── Redis ───
REDIS_URL=redis://localhost:6379/0

# ─── Qdrant ───
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# ─── MinIO ───
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=deepdocs
MINIO_SECRET_KEY=deepdocs_secret
MINIO_BUCKET=deepdocs-files

# ─── 认证 ───
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ─── 嵌入模型（按优先级） ───
# 本地 BGE-M3：TOML 配置下载路径
BGE_MODEL_PATH=./models/bge-m3
RERANKER_MODEL_PATH=./models/bge-reranker-v2-m3

# 云端嵌入备选
OPENAI_API_KEY=
SILICONFLOW_API_KEY=
DASHSCOPE_API_KEY=

# ─── 监控 ───
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=INFO

# ─── 存储 ───
UPLOAD_MAX_SIZE_MB=100
DEFAULT_LOCALE=zh-CN
